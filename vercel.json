{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd Vue-Project-Template && npm ci",
  "buildCommand": "cd Vue-Project-Template && npm run build",
  "outputDirectory": "Vue-Project-Template/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
